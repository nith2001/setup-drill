{
  "name": "setup-drill",
  "version": "1.0.0",
  "description": "Practice day-trading setups on replayed 1-minute charts",
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "reports": "CHECK=reports VITE_CONFIG_NATIVE_IGNORE_WARNING=true vitest run --reporter=dot",
    "audit": "CHECK=audit VITE_CONFIG_NATIVE_IGNORE_WARNING=true vitest run --reporter=dot"
  },
  "dependencies": {
    "lightweight-charts": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "5.9",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "private": true,
  "type": "module"
}
