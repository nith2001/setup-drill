# Alpaca paper-account keys (free: alpaca.markets → Paper Trading → API Keys → Generate).
# Copy to .env. Never commit .env.
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=

# Optional: what `npm run dev` syncs in the background (defaults shown)
# SYNC_DAYS=100            # trading days to keep cached in data/days.json
# SYNC_YEARS=3             # sample dates from the last N years
# SYNC_SYMBOLS=AAPL,MSFT,NVDA,TSLA,AMD,META,AMZN,GOOGL,NFLX,COIN,PLTR,SHOP,UBER,BA,JPM,XOM,SMCI,MU,SOFI,SPY
